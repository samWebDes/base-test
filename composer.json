{
  "name": "cmscoe/tyler-cms",
  "description": "Tyler CMS Base Site website (CMS COE platform).",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "repositories": [
    {
      "type": "artifact",
      "url": "packages/",
      "only": [
        "cmscoe/*"
      ]
    },
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    }
  ],
  "require": {
    "php": ">=8.3",
    "cmscoe/forge": "^0.3",
    "cmscoe/platform": "^0.4",
    "composer/installers": "^2.3",
    "wpackagist-plugin/secure-custom-fields": "^6.9",
    "wpackagist-plugin/admin-menu-editor": "^1.15",
    "wpackagist-plugin/members": "^3.2",
    "wpackagist-plugin/revisionary": "^4.2"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "extra": {
    "installer-paths": {
      "wp-content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "wp-content/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    }
  },
  "config": {
    "platform": {
      "php": "8.4"
    },
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "find wp-content/plugins/tyler-cms-* wp-content/themes/tyler-cms-theme bin tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "phpcs": "phpcs"
  }
}
