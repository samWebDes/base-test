{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cmscoe/directory",
	"version": "0.2.0",
	"title": "Directory",
	"category": "cmscoe-forge",
	"icon": "list-view",
	"description": "Filterable, paginated list of any content type, with taxonomy filters. Works without JavaScript.",
	"keywords": [ "directory", "list", "filter", "search", "archive" ],
	"textdomain": "cmscoe-platform",
	"attributes": {
		"postType": { "type": "string", "default": "" },
		"taxonomies": { "type": "array", "items": { "type": "string" }, "default": [] },
		"perPage": { "type": "integer", "default": 12, "minimum": 1, "maximum": 48 },
		"showSearch": { "type": "boolean", "default": true },
		"orderBy": { "type": "string", "enum": [ "title", "date" ], "default": "title" }
	},
	"supports": { "html": false, "reusable": false, "multiple": false, "align": [ "wide" ] },
	"editorScript": "file:./index.js",
	"script": "cmscoe-forge-runtime",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
