{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"gradients": [],
			"duotone": [],
			"palette": [
				{
					"slug": "primary",
					"color": "#01558F",
					"name": "Primary"
				},
				{
					"slug": "on-primary",
					"color": "#FFFFFF",
					"name": "Text on primary"
				},
				{
					"slug": "primary-text",
					"color": "#01558F",
					"name": "Primary, accessible text on white"
				},
				{
					"slug": "primary-tint",
					"color": "#E6EEF4",
					"name": "Primary tint"
				},
				{
					"slug": "secondary",
					"color": "#8E9A47",
					"name": "Secondary"
				},
				{
					"slug": "on-secondary",
					"color": "#1F2933",
					"name": "Text on secondary"
				},
				{
					"slug": "secondary-text",
					"color": "#727B39",
					"name": "Secondary, accessible text on white"
				},
				{
					"slug": "neutral-dark",
					"color": "#1F2933",
					"name": "Neutral dark"
				},
				{
					"slug": "neutral-light",
					"color": "#F5F7FA",
					"name": "Neutral light"
				},
				{
					"slug": "white",
					"color": "#FFFFFF",
					"name": "White"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Public Sans",
					"slug": "body",
					"fontFamily": "\"Public Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Public Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/body-normal.woff2"
							]
						},
						{
							"fontFamily": "Public Sans",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/body-italic.woff2"
							]
						}
					]
				},
				{
					"name": "Merriweather Sans",
					"slug": "heading",
					"fontFamily": "\"Merriweather Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Merriweather Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/heading-normal.woff2"
							]
						},
						{
							"fontFamily": "Merriweather Sans",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/heading-italic.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1.125rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.375rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					},
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "2rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2.25rem"
					},
					"name": "Extra large"
				},
				{
					"slug": "xx-large",
					"size": "3rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3.25rem"
					},
					"name": "Huge"
				}
			]
		},
		"spacing": {
			"units": [
				"rem",
				"%",
				"vw"
			],
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "XS"
				},
				{
					"slug": "30",
					"size": "1rem",
					"name": "S"
				},
				{
					"slug": "40",
					"size": "1.5rem",
					"name": "M"
				},
				{
					"slug": "50",
					"size": "2rem",
					"name": "L"
				},
				{
					"slug": "60",
					"size": "clamp(2rem, 5vw, 4rem)",
					"name": "XL"
				}
			]
		},
		"layout": {
			"contentSize": "48rem",
			"wideSize": "80rem"
		},
		"border": {
			"radius": false,
			"color": false,
			"style": false,
			"width": false
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--neutral-dark)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary-text)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--neutral-dark)",
						"offset": "2px",
						"style": "solid",
						"width": "3px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--neutral-dark)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--on-primary)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--large)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--on-primary)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--on-primary)"
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [],
	"patterns": []
}
